# doxyYoda Demo — Doxyfile
# Build with: pixi run demo
#
# Doxygen 1.9.1 is unsupported. Requires Doxygen 1.17 or newer.
# 1.9.1 ignores HTML_CODE_FOLDING, FULL_SIDEBAR, and MATHJAX_VERSION,
# leaves $darkmode $mermaidjs $langISO $projecticon literal, does not
# emit codefolding.js, and does not honor this header's BEGIN/END blocks
# or the current LAYOUT_FILE.
# Compile src/styles/doxyYoda.css (sass) before doxygen. Fonts are @import
# rules inside that sheet, not files copied by pixi.
# Preview with: python -m http.server 8000 -d demo/build/html
# Do not open the HTML via file://. The toggle is localStorage only.

PROJECT_NAME           = "doxyYoda"
PROJECT_NUMBER         = "0.2.2"
PROJECT_BRIEF          = "A modern Doxygen theme — CSS Grid, fog-over-fen, dark mode"
PROJECT_LOGO           = src/images/doxyYoda_logo.png

OUTPUT_DIRECTORY       = demo/build
INPUT                  = demo/src
FILE_PATTERNS          = *.hpp *.cpp *.dox
RECURSIVE              = YES

# Theme
HTML_HEADER            = src/html/header.html
HTML_FOOTER            = src/html/footer.html
HTML_EXTRA_STYLESHEET  = src/styles/doxyYoda.css
LAYOUT_FILE            = src/xml/doxyYoda.xml

# Output
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO

# Content
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
SHOW_INCLUDE_FILES     = YES
INLINE_SOURCES         = YES
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# Math
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3

# Search
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

# Doxygen 1.17+ HTML interactivity
HTML_DYNAMIC_SECTIONS  = YES
HTML_CODE_FOLDING      = YES

# Warnings
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES

# Groups
DISTRIBUTE_GROUP_DOC   = YES
GROUP_NESTED_COMPOUNDS = YES

# Misc
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
SORT_BRIEF_DOCS        = YES
SORT_MEMBERS_CTORS_1ST = YES
SHOW_GROUPED_MEMB_INC  = YES

# Graphs (Graphviz/dot)
HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

# Keep it quiet
QUIET                  = YES
WARNINGS               = YES
